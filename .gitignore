# Dependencies
node_modules/

# Local database — never commit real data (ADR-0033, ADR-0049 §6)
brainy.db
brainy.db-journal
brainy.db-wal
brainy.db-shm

# Local DB backups (tools/scripts/backup-db.mjs) — same sensitivity as brainy.db itself
backups/

# Uploaded file-node content (F-26, Phase 2) — real user data, same sensitivity tier as
# brainy.db; content-addressed by sha256, never committed
/uploads/

# Whisper.cpp GGML model file (Phase 5, ADR-0088) — a multi-hundred-MB binary Istiyak
# downloads himself; not source, never committed, same tier as node_modules/.
/models/

# yt-dlp.exe / ffmpeg.exe (Phase 5, ADR-0088) — standalone binaries Istiyak downloads
# himself into tools/, same tier as /models/ above. tools/scripts/ (the tracked
# backup-db.mjs helper) is unaffected — this only matches .exe files directly in tools/.
/tools/*.exe

# Secrets
.env
.env.local
.env.*.local

# Local encryption key for provider_credentials.api_key (ADR-0060) — generated on first
# server boot, unique per machine; never committed
apps/server/.local-key

# Build output
packages/tokens/build/
apps/web/.next/
apps/server/dist/
storybook-static/

# Claude Code — personal/local settings only; .claude/settings.json (team-shared) and
# .claude/rules, .claude/skills are intentionally committed (ADR-0050)
.claude/settings.local.json

# OS / editor junk
Thumbs.db
.DS_Store
*.log
npm-debug.log*

# VS Code — keep shared workspace settings if any are added later; ignore personal overrides
.vscode/*
!.vscode/extensions.json
