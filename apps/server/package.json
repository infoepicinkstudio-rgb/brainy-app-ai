{
  "name": "@brainy/server",
  "private": true,
  "version": "0.0.0",
  "description": "Brainy backend — Fastify. Owns SQLite/Drizzle, AI provider calls, yt-dlp/ffmpeg jobs. See architecture.md §4.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "@fastify/cors": "^11.3.1",
    "drizzle-orm": "^0.45.4",
    "@libsql/client": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
