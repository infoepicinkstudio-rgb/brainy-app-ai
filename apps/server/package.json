{
  "name": "@brainy/server",
  "private": true,
  "version": "0.0.0",
  "description": "Brainy backend — Fastify. Owns SQLite/Drizzle, AI provider calls, yt-dlp/ffmpeg jobs. See architecture.md §4.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fugood/whisper.node": "^1.2.0-rc.1",
    "@libsql/client": "^0.18.0",
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jsdom": "^30.1.3",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
